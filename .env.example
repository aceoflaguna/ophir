NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://asyong:asyong@localhost:5432/ophir
PG_POOL_MAX=10

# Valkey (Redis protocol compatible)
VALKEY_URL=redis://localhost:6379

# JWT: access token (short-lived, stateless) + refresh token (opaque, hashed in DB, rotated)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ISSUER=ophir-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Matching
MATCH_SEARCH_RADIUS_KM=5
MATCH_MAX_CANDIDATES=10
DRIVER_OFFER_TIMEOUT_SECONDS=20
RIDE_SEARCH_TIMEOUT_SECONDS=180

# Pricing
BASE_FARE=2.50
PER_KM=1.20
PER_MINUTE=0.35
MIN_FARE=5.00
CURRENCY=USD
PLATFORM_FEE_PERCENT=20

# Housekeeping
DRIVER_STALE_SECONDS=120
ARRIVAL_RADIUS_KM=0.5
STUCK_RIDE_HOURS=6
AUTH_RATE_LIMIT_MAX=20
